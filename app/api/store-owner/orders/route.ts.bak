import { NextRequest, NextResponse } from "next/server";
import { getToken } from "next-auth/jwt";
import { prisma } from "../../../../lib/prisma";

export async function GET(request: Request) {
  try {
    // 1. Check logged-in user
    const token = await getToken({
      req: request,
      secret: process.env.NEXTAUTH_SECRET,
      secureCookie: false,
    });

    if (!token?.id) {
      return NextResponse.json(
        { message: "You must be logged in." },
        { status: 401 }
      );
    }

    // 2. Only Store Owners can access this API
    if (token.role !== "STORE_OWNER") {
      return NextResponse.json(
        { message: "Only Store Owners can access orders." },
        { status: 403 }
      );
    }

    // 3. Find stores owned by the logged-in user
    const stores = await prisma.store.findMany({
      where: {
        ownerId: String(token.id),
      },
      select: {
        storeId: true,
      },
    });

    const storeIds = stores.map((store) => store.storeId);

    // 4. Get orders belonging only to those stores
    const orders = await prisma.order.findMany({
      where: {
        storeId: {
          in: storeIds,
        },
      },
      include: {
        customer: {
          select: {
            fullName: true,
            email: true,
            phoneNumber: true,
          },
        },
        address: true,
        items: {
          include: {
            product: {
              select: {
                productId: true,
                productName: true,
              },
            },
          },
        },
        payments: {
          select: {
            paymentId: true,
            provider: true,
            amount: true,
            status: true,
            transactionReference: true,
            paidAt: true,
          },
        },
        store: {
          select: {
            storeId: true,
            storeName: true,
          },
        },
      },
      orderBy: {
        createdAt: "desc",
      },
    });

    return NextResponse.json({ orders });
  } catch (error) {
    console.error("Store owner orders error:", error);

    return NextResponse.json(
      {
        message: "Something went wrong while loading orders.",
      },
      { status: 500 }
    );
  }
}